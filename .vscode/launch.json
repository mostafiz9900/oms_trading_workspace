{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Benemoy UAT",
      "request": "launch",
      "type": "dart",
      "cwd": "${workspaceFolder}/apps/benemoy",
      "program": "${workspaceFolder}/apps/benemoy/lib/main_uat.dart",
      "args": ["--dart-define-from-file=env/uat.json"]
    },
    {
      "name": "Benemoy Prod",
      "request": "launch",
      "type": "dart",
      "cwd": "${workspaceFolder}/apps/benemoy",
      "program": "${workspaceFolder}/apps/benemoy/lib/main_prod.dart",
      "args": ["--dart-define-from-file=env/prod.json"]
    }
  ]
}
